<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The hardened runtime's exceptions for a release build (docs/release-plan.md §2): what Electron's
     V8 needs, and nothing else. No disable-library-validation (gate run 2, M-3), so a replaced
     pty.node fails to load; no microphone, since the app has no dictation (D-008). -->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
</dict>
</plist>
